# Variables d'environnement du backend firstagent
#
# Copiez ce fichier en .env et renseignez les valeurs, ou exportez-les dans
# l'environnement avant de démarrer. Aucune valeur sensible ne figure ici :
# un secret versionné, même « de dev », finit en production.
#
# Spring Boot ne lit pas .env de lui-même : voir la note de démarrage en bas.

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# PostgreSQL 16 tourne déjà sur ce poste (port 5432) et la base
# firstagent_onboarding existe. Rien à installer.
DB_URL=jdbc:postgresql://localhost:5432/firstagent_onboarding

# ---------------------------------------------------------------------------
# Messagerie — codes de vérification de l'adresse e-mail
# ---------------------------------------------------------------------------
# OBLIGATOIRE. Sans cette variable, Spring échoue au démarrage sur un
# placeholder non résolu, et c'est ce qui a été pris pour une « panne SMTP ».
# Le serveur, le port et le compte ci-dessous sont corrects et vérifiés :
# l'authentification Office 365 passe depuis ce poste.
MAIL_PASSWORD=

MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=agent_dri_03@afrilandfirstbank.com
MAIL_FROM_ADDRESS=agent_dri_03@afrilandfirstbank.com

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
# OBLIGATOIRE. 32 caractères minimum.
# Génération : openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# Microservice de vision (OCR, visage, vivacité, comparaison biométrique)
# ---------------------------------------------------------------------------
VISION_SERVICE_URL=http://localhost:8001
# Doit valoir exactement l'INTERNAL_API_KEY du python-service.
VISION_SERVICE_API_KEY=

# ---------------------------------------------------------------------------
# Démarrage
# ---------------------------------------------------------------------------
# PowerShell :
#   Get-Content .env | Where-Object { $_ -match '^[A-Z]' } | ForEach-Object {
#       $n, $v = $_ -split '=', 2; [Environment]::SetEnvironmentVariable($n, $v) }
#   .\mvnw spring-boot:run
#
# Bash :
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run
