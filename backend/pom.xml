<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Réacteur multi-module imposé par la charte backend §2 et §3, avec le
	  découpage de référence de l'annexe : domain, commons, application,
	  infrastructure, boot.

	  Le sens des dépendances est unique et ne se remonte jamais :
	      boot -> infrastructure -> application -> commons -> domain

	  L'intérêt n'est pas cosmétique. Dans un module unique, rien n'empêche le
	  domaine d'importer Spring ou JPA : la règle ne tient que par la
	  discipline. Ici l'enforcer la vérifie à chaque compilation.

	  ÉTAT DE LA MIGRATION. Ce découpage est le premier temps d'un chantier en
	  plusieurs passes. Le module domain ne contient pour l'instant que ce qui
	  est réellement pur (les énumérations métier) ; le reste du code attend
	  dans infrastructure. Les passes suivantes en extrairont les modèles
	  métier, les ports et les cas d'usage.

	  Obstacle identifié pour la suite : les exceptions métier portent toutes
	  un HttpStatus, donc une dépendance à Spring. Les faire descendre dans
	  domain suppose de les découpler du transport, la correspondance vers un
	  code HTTP relevant du @RestControllerAdvice.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.7</version>
		<relativePath/>
	</parent>

	<groupId>com.firstagent</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>firstagent-backend</name>
	<description>Microservice d'onboarding FirstAgent</description>

	<modules>
		<module>firstagent-domain</module>
		<module>firstagent-commons</module>
		<module>firstagent-application</module>
		<module>firstagent-infrastructure</module>
		<module>firstagent-boot</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
		<spring-ai.version>2.0.0</spring-ai.version>
		<springdoc.version>3.0.3</springdoc.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-commons</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-infrastructure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!--
			  Formatage mécanisé (charte §10). google-java-format ne se
			  configure pas : c'est le but, il retire le sujet des revues.
			  `spotless:apply` reformate, `spotless:check` refuse un code non
			  formaté. Le contrôle est attaché à `validate` pour échouer avant
			  la compilation plutôt qu'après les tests.
			-->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.44.5</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>1.28.0</version>
						</googleJavaFormat>
						<removeUnusedImports/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>controle-formatage</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
			  Couverture de tests (charte §11). Le seuil visé est 80 %, mais le
			  rendre bloquant aujourd'hui casserait le build : la couverture
			  réelle en est loin. La mesure est donc activée d'abord, le seuil
			  sera relevé par paliers à mesure que les tests arrivent.
			  Rapport : firstagent-*/target/site/jacoco/index.html
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>rapport</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<!--
					  Cliquet de non-régression. Sa seule fonction est
					  d'empêcher la couverture de baisser, et il est fixé juste
					  en dessous de la mesure pour ne pas rendre le build
					  instable.

					  Il doit être relevé à chaque palier gagné, jusqu'aux 80 %
					  exigés par la charte §11 : le laisser en place pendant que
					  la couverture progresse reviendrait à s'en accommoder.

					  ATTENTION : le seuil s'applique PAR MODULE et non sur
					  l'agrégat. Il vaut donc ce que franchit le module le plus
					  faible, et le caler sur l'agrégat casse le build.

					  Au 07/08/2026 l'ensemble est à 48,8 %, mais boot n'est qu'à
					  37 % : ce module ne contient que la classe de démarrage et
					  la configuration, que les tests traversent sans les
					  exercer. Le cliquet reste donc à 35 %, et il ne montera
					  qu'en couvrant boot, pas en couvrant le métier.

					  Historique des relèvements :
					    06/08/2026  34 % mesurés sur 4 383 instructions  -> 30 %
					    06/08/2026  39,6 % sur 6 123 instructions        -> 35 %
					                (journal d'audit et alertes, testés)
					    06/08/2026  41,9 % agrégés                      -> 35 %
					                (instrumentation du parcours, vivacité et
					                 règles d'alerte testées)

					  POURQUOI LE PLANCHER EST SOUS LA MESURE AGRÉGÉE. Le contrôle
					  s'applique module par module, pas sur l'ensemble : le
					  plancher ne peut donc pas dépasser le module le moins
					  couvert. C'est aujourd'hui le module boot, à 37,5 %, et pour
					  une raison sans portée : il ne contient que le point
					  d'entrée, dont la méthode main se borne à démarrer Spring
					  et n'a rien à vérifier. Les modules qui portent du code réel sont
					  plus haut : commons 97,8 %, domain 46,8 %,
					  infrastructure 40,8 %.
					-->
					<execution>
						<id>plancher-de-couverture</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.35</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
							<haltOnFailure>true</haltOnFailure>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			  PMD : « code smells » et copier-coller (charte §10).

			  Il comble ce que les trois autres outils ne voient pas. Spotless
			  met en forme, Checkstyle vérifie les conventions, SpotBugs cherche
			  des défauts d'exécution ; PMD, lui, regarde la structure : méthode
			  trop longue, condition inutilement complexe, ressource non
			  refermée, et surtout duplication.

			  RAPPORT AVEC SONARQUBE. La porte SonarQube exigée par la charte
			  suppose un serveur, qui n'existe pas encore. Une grande part de
			  ses règles Java vient cependant de ce moteur : l'ajouter ici fait
			  tourner l'analyse aujourd'hui, sans attendre l'infrastructure. Le
			  serveur restera nécessaire pour la porte elle-même, le suivi dans
			  le temps et la notion de « code nouveau ».

			  Non bloquant pour les mêmes raisons que SpotBugs : le parc
			  existant n'a pas été traité.
			  Rapport : firstagent-*/target/pmd.xml et cpd.xml
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.26.0</version>
				<configuration>
					<targetJdk>21</targetJdk>
					<printFailingErrors>true</printFailingErrors>
					<failOnViolation>false</failOnViolation>
					<rulesets>
						<ruleset>${maven.multiModuleProjectDirectory}/config/pmd-ruleset.xml</ruleset>
					</rulesets>
					<excludeRoots>
						<excludeRoot>target/generated-sources</excludeRoot>
					</excludeRoots>
					<!--
					  Seuil de duplication. 100 jetons représentent une bonne
					  vingtaine de lignes : en deçà, on signalerait des suites
					  d'accesseurs et des blocs de construction qui se
					  ressemblent sans être du copier-coller.
					-->
					<minimumTokens>100</minimumTokens>
				</configuration>
				<executions>
					<execution>
						<id>analyse-structure</id>
						<phase>verify</phase>
						<goals>
							<goal>pmd</goal>
							<goal>cpd</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
			  Détection de bugs et de failles (charte §10). FindSecBugs ajoute
			  à SpotBugs les motifs propres à la sécurité : injections,
			  aléatoire prévisible, secrets en dur, désérialisation.
			  Rapport : firstagent-*/target/spotbugsXml.xml
			-->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.9.8.0</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<!--
					  Exclusions motivées une à une dans le fichier. Le chemin
					  part de la racine du réacteur : un chemin relatif serait
					  résolu depuis chaque module et ne serait trouvé nulle part.
					-->
					<excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclusions.xml</excludeFilterFile>
					<!--
					  Non bloquant pour l'instant : le parc de défauts existant
					  n'a pas été traité, et faire échouer le build dès
					  aujourd'hui empêcherait toute autre correction
					  d'avancer. À passer à `true` une fois les signalements
					  résorbés, comme l'exige la charte.
					-->
					<failOnError>false</failOnError>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>1.14.0</version>
						</plugin>
					</plugins>
				</configuration>
				<executions>
					<execution>
						<id>analyse-securite</id>
						<phase>verify</phase>
						<goals>
							<goal>spotbugs</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
			  Contrôle des conventions (charte §10). Le jeu de règles est
			  volontairement restreint à ce que le formatage ne voit pas :
			  nommage, complexité, pièges de correction. Détail et motifs
			  dans config/checkstyle.xml.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<dependencies>
					<!--
					  Le moteur est plus récent que celui embarqué par défaut
					  dans le plugin : les versions livrées avec le plugin
					  ignorent une partie de la syntaxe de Java 21.
					-->
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>10.21.0</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
					<propertyExpansion>suppressions=${maven.multiModuleProjectDirectory}/config/checkstyle-suppressions.xml</propertyExpansion>
					<consoleOutput>true</consoleOutput>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<!-- Seules les règles en `error` arrêtent le build ; les `warning` sont affichées. -->
					<violationSeverity>error</violationSeverity>
					<failOnViolation>true</failOnViolation>
				</configuration>
				<executions>
					<execution>
						<id>controle-conventions</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
			  Verrouillage des versions de Java et de Maven (charte §2). Sans
			  lui, un poste avec un autre JDK produit un artefact différent
			  sans que rien ne le signale.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>verrouillage-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[21,22)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
