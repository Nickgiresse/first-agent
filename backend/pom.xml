<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Réacteur multi-module imposé par la charte backend §2 et §3, avec le
	  découpage de référence de l'annexe : domain, commons, application,
	  infrastructure, boot.

	  Le sens des dépendances est unique et ne se remonte jamais :
	      boot -> infrastructure -> application -> commons -> domain

	  L'intérêt n'est pas cosmétique. Dans un module unique, rien n'empêche le
	  domaine d'importer Spring ou JPA : la règle ne tient que par la
	  discipline. Ici l'enforcer la vérifie à chaque compilation.

	  ÉTAT DE LA MIGRATION. Ce découpage est le premier temps d'un chantier en
	  plusieurs passes. Le module domain ne contient pour l'instant que ce qui
	  est réellement pur (les énumérations métier) ; le reste du code attend
	  dans infrastructure. Les passes suivantes en extrairont les modèles
	  métier, les ports et les cas d'usage.

	  Obstacle identifié pour la suite : les exceptions métier portent toutes
	  un HttpStatus, donc une dépendance à Spring. Les faire descendre dans
	  domain suppose de les découpler du transport, la correspondance vers un
	  code HTTP relevant du @RestControllerAdvice.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.7</version>
		<relativePath/>
	</parent>

	<groupId>com.firstagent</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>firstagent-backend</name>
	<description>Microservice d'onboarding FirstAgent</description>

	<modules>
		<module>firstagent-domain</module>
		<module>firstagent-commons</module>
		<module>firstagent-application</module>
		<module>firstagent-infrastructure</module>
		<module>firstagent-boot</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
		<spring-ai.version>2.0.0</spring-ai.version>
		<springdoc.version>3.0.3</springdoc.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-commons</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.firstagent</groupId>
				<artifactId>firstagent-infrastructure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!--
			  Couverture de tests (charte §11). Le seuil visé est 80 %, mais le
			  rendre bloquant aujourd'hui casserait le build : la couverture
			  réelle en est loin. La mesure est donc activée d'abord, le seuil
			  sera relevé par paliers à mesure que les tests arrivent.
			  Rapport : firstagent-*/target/site/jacoco/index.html
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>rapport</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<!--
					  Cliquet de non-régression. Mesure du 06/08/2026 : 34 % sur
					  4 383 instructions. Le plancher est fixé juste en dessous
					  pour ne pas rendre le build instable, et sa seule fonction
					  est d'empêcher la couverture de baisser.

					  Il doit être relevé à chaque palier gagné, jusqu'aux 80 %
					  exigés par la charte §11. Le laisser à 30 % indéfiniment
					  reviendrait à s'en accommoder.
					-->
					<execution>
						<id>plancher-de-couverture</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.30</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
							<haltOnFailure>true</haltOnFailure>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			  Verrouillage des versions de Java et de Maven (charte §2). Sans
			  lui, un poste avec un autre JDK produit un artefact différent
			  sans que rien ne le signale.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>verrouillage-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[21,22)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
