<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.firstagent</groupId>
		<artifactId>backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>firstagent-infrastructure</artifactId>
	<name>firstagent-infrastructure</name>
	<description>Adapters entrants et sortants, configuration technique.</description>

	<!--
	  Ce module porte aujourd'hui la quasi-totalité du code : contrôleurs,
	  services, entités et repositories, encore organisés en couches par
	  domaine fonctionnel. C'est l'état intermédiaire assumé du découpage.

	  Les passes suivantes en extrairont, dans l'ordre : les modèles métier
	  vers domain, les ports et cas d'usage vers application, les briques
	  transverses vers commons. Ne restera ici que ce qui touche réellement à
	  la technique.
	-->

	<dependencies>
		<dependency>
			<groupId>com.firstagent</groupId>
			<artifactId>firstagent-application</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- BCrypt pour le hachage du PIN, sans authentification applicative -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

</project>
