<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.firstagent</groupId>
		<artifactId>backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>firstagent-domain</artifactId>
	<name>firstagent-domain</name>
	<description>Cœur métier. Aucune dépendance technique.</description>

	<!--
	  AUCUNE DÉPENDANCE, volontairement. La charte §3 qualifie la pureté de ce
	  module de non négociable : ni Spring, ni Reactor, ni JPA, ni R2DBC, ni
	  Lombok. Les règles bannies ci-dessous font échouer le build si l'une
	  d'elles réapparaît, y compris de façon transitive.

	  Une exception ajoutée par commodité suffirait à rendre le métier
	  dépendant d'un framework, et c'est précisément ce que le découpage vise
	  à empêcher.
	-->

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>purete-du-domaine</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>org.springframework:*</exclude>
										<exclude>org.springframework.boot:*</exclude>
										<exclude>org.springframework.data:*</exclude>
										<exclude>org.springframework.security:*</exclude>
										<exclude>io.projectreactor:*</exclude>
										<exclude>jakarta.persistence:*</exclude>
										<exclude>org.hibernate:*</exclude>
										<exclude>org.hibernate.orm:*</exclude>
										<exclude>org.projectlombok:*</exclude>
										<exclude>com.fasterxml.jackson.core:*</exclude>
									</excludes>
									<message>
										Le module domain doit rester pur : ni Spring, ni Reactor,
										ni JPA/Hibernate, ni Lombok, ni Jackson (charte backend §3).
										La dépendance ci-dessus doit vivre dans commons,
										application ou infrastructure selon son rôle.
									</message>
								</bannedDependencies>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
